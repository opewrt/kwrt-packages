+typedef struct _PCatGPIODLine
+{
+    struct gpiod_line_request *request;
+    guint offset;
+}PCatGPIODLine;
+
+static struct gpiod_chip *pcat_gpiod_chip_open_by_name(const gchar *name)
+{
+    struct gpiod_chip *chip;
+    gchar *path;
+
+    path = name[0]=='/' ? g_strdup(name) : g_strdup_printf("/dev/%s", name);
+    chip = gpiod_chip_open(path);
+    g_free(path);
+
+    return chip;
+}
+
+static PCatGPIODLine *pcat_gpiod_chip_get_line(
+    struct gpiod_chip *chip, guint offset)
+{
+    PCatGPIODLine *line;
+
+    if(chip==NULL)
+    {
+        return NULL;
+    }
+
+    line = g_new0(PCatGPIODLine, 1);
+    line->offset = offset;
+
+    return line;
+}
+
+static gboolean pcat_gpiod_line_is_requested(PCatGPIODLine *line)
+{
+    return line->request!=NULL;
+}
+
+static gint pcat_gpiod_line_request_output(PCatGPIODLine *line,
+    struct gpiod_chip *chip, const gchar *consumer, gint value)
+{
+    struct gpiod_line_settings *settings = NULL;
+    struct gpiod_line_config *line_config = NULL;
+    struct gpiod_request_config *request_config = NULL;
+    gint ret = -1;
+
+    settings = gpiod_line_settings_new();
+    line_config = gpiod_line_config_new();
+    request_config = gpiod_request_config_new();
+    if(settings==NULL || line_config==NULL || request_config==NULL)
+    {
+        goto out;
+    }
+
+    if(gpiod_line_settings_set_direction(settings,
+        GPIOD_LINE_DIRECTION_OUTPUT)!=0 ||
+        gpiod_line_settings_set_output_value(settings,
+        value ? GPIOD_LINE_VALUE_ACTIVE : GPIOD_LINE_VALUE_INACTIVE)!=0 ||
+        gpiod_line_config_add_line_settings(line_config, &line->offset, 1,
+        settings)!=0)
+    {
+        goto out;
+    }
+
+    gpiod_request_config_set_consumer(request_config, consumer);
+    line->request = gpiod_chip_request_lines(chip, request_config, line_config);
+    if(line->request!=NULL)
+    {
+        ret = 0;
+    }
+
+out:
+    gpiod_request_config_free(request_config);
+    gpiod_line_config_free(line_config);
+    gpiod_line_settings_free(settings);
+
+    return ret;
+}
+
+static gint pcat_gpiod_line_set_value(PCatGPIODLine *line, gint value)
+{
+    if(line==NULL || line->request==NULL)
+    {
+        return -1;
+    }
+
+    return gpiod_line_request_set_value(line->request, line->offset,
+        value ? GPIOD_LINE_VALUE_ACTIVE : GPIOD_LINE_VALUE_INACTIVE);
+}
+
+static void pcat_gpiod_line_release(PCatGPIODLine *line)
+{
+    if(line->request!=NULL)
+    {
+        gpiod_line_request_release(line->request);
+    }
+    g_free(line);
+}
